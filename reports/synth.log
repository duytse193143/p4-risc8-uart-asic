    # 1. read the Sky130 cell list (as black boxes) and the RTL
    read_liberty -lib /home/tranduy/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
    read_verilog src/alu.v src/data_ram.v src/prog_rom.v src/regfile.v src/risc8_core.v src/risc8_uart_top.v src/uart_rx.v src/uart_tx.v 

    # 2. generic synthesis (flatten = one netlist for the whole chip)
    #    -nofsm keeps the FSM state encoding exactly as written in the RTL,
    #    so every register in the netlist matches the RTL for LEC (D44)
    synth -top risc8_uart_top -flatten -nofsm

    # 3. map flip-flops to Sky130 flip-flop cells
    dfflibmap -liberty /home/tranduy/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use *lpflow* -dont_use *probe*

    # 4. map logic to Sky130 gates, aiming for a 5 ns (200 MHz) clock
    #    (low-power isolation and probe cells are not for normal logic)
    abc -D 5000 -liberty /home/tranduy/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use *lpflow* -dont_use *probe* -showtmp

    # 5. constant 0/1 cells, clean up
    hilomap -singleton -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
    splitnets -ports
    opt_clean -purge

    # 6. reports + netlist
    tee -o reports/synth_stat.txt stat -liberty /home/tranduy/.ciel/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
    tee -o reports/synth_check.txt check -assert
    write_verilog -noattr -noexpr -nohex -nodec results/risc8_uart_top.synth.v
' --

